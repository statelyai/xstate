{
  "name": "xstate-monorepo",
  "private": true,
  "description": "Finite State Machines and Statecharts for the Modern Web.",
  "workspaces": {
    "packages": [
      "packages/*",
      "scripts/*"
    ]
  },
  "preconstruct": {
    "packages": [
      "packages/!(xstate-dev)"
    ],
    "globals": {
      "react": "React"
    },
    "exports": {
      "importConditionDefaultExport": "default"
    },
    "___experimentalFlags_WILL_CHANGE_IN_PATCH": {
      "importsConditions": true,
      "typeModule": true,
      "distInRoot": true
    }
  },
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.js",
    "postinstall": "manypkg check && preconstruct dev",
    "build": "preconstruct build",
    "update:examples": "pnpm update:examples:deps && pnpm update:examples:links",
    "update:examples:deps": "node ./scripts/update-example-deps.js",
    "update:examples:links": "node ./scripts/update-example-links.js",
    "fix": "manypkg fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --quiet --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --fix --report-unused-disable-directives-severity=error",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run --project xstate",
    "test:core:watch": "vitest --project xstate",
    "test:store": "vitest run --project @xstate/store*",
    "test:store:watch": "vitest --project @xstate/store*",
    "changeset": "changeset",
    "release": "changeset publish",
    "version": "changeset version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statelyai/xstate.git"
  },
  "author": "David Khourshid <davidkpiano@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/statelyai/xstate/issues"
  },
  "homepage": "https://github.com/statelyai/xstate#readme",
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@manypkg/cli": "^0.21.4",
    "@preconstruct/cli": "^2.8.13",
    "@types/node": "25.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-preset-solid": "^1.9.12",
    "eslint-plugin-jsdoc": "^63.3.2",
    "happy-dom": "^17.6.3",
    "husky": "^3.1.0",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "synckit": "^0.8.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.7"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "!(CLAUDE).{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,json5,md,mdx,css,scss,less,yml,yaml,html}": "oxfmt --write"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "25.2.1",
      "stylus": "0.55.0",
      "vite": "5.4.21"
    },
    "patchedDependencies": {
      "@vue/test-utils@2.4.6": "patches/@vue__test-utils@2.4.6.patch"
    }
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
