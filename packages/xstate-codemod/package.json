{
  "name": "@xstate/codemod",
  "version": "0.1.0-alpha.4",
  "description": "Codemods for migrating XState source between versions (v5 \u2192 v6)",
  "keywords": [
    "xstate",
    "codemod",
    "migration",
    "ts-morph"
  ],
  "author": "David Khourshid <davidkpiano@gmail.com>",
  "homepage": "https://github.com/statelyai/xstate/tree/main/packages/xstate-codemod#readme",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xstate-codemod": "./bin/codemod.js"
  },
  "exports": {
    ".": "./dist/xstate-codemod.js",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statelyai/xstate.git"
  },
  "bugs": {
    "url": "https://github.com/statelyai/xstate/issues"
  },
  "dependencies": {
    "ts-morph": "^24.0.0",
    "tsx": "^4.23.13",
    "xstate": "workspace:^",
    "xstate5": "npm:xstate@^5.33.0"
  },
  "devDependencies": {
    "vitest": "^3.2.2"
  },
  "preconstruct": {
    "umdName": "XStateCodemod",
    "entrypoints": [
      "./index.ts"
    ]
  }
}
