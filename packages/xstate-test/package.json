{
  "name": "@xstate/test",
  "version": "2.0.0-alpha.0",
  "description": "Model-based and property-based testing for XState, built on fast-check",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/xstate-test.js",
    "./schema": "./dist/xstate-test-schema.js",
    "./playwright": "./dist/xstate-test-playwright.js",
    "./effect-schema": "./dist/xstate-test-effect-schema.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statelyai/xstate.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "effect": "4.0.0-beta.106",
    "fast-check": "^4.9.0",
    "xstate": "workspace:^",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "effect": "4.0.0-beta.106",
    "fast-check": "^4.9.0",
    "xstate": "workspace:^",
    "zod": "^4.4.3"
  },
  "preconstruct": {
    "umdName": "XStateTest",
    "entrypoints": [
      "./index.ts",
      "./effect-schema.ts",
      "./schema.ts",
      "./playwright.ts"
    ]
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
