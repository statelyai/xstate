{
  "name": "@xstate/rivet",
  "version": "0.1.0-alpha.0",
  "description": "Run XState machines with Rivet durable actors",
  "keywords": [
    "xstate",
    "rivet",
    "durable execution",
    "actor"
  ],
  "license": "MIT",
  "main": "dist/xstate-rivet.cjs.js",
  "module": "dist/xstate-rivet.esm.js",
  "types": "dist/xstate-rivet.cjs.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/xstate-rivet.cjs.mjs",
        "default": "./dist/xstate-rivet.cjs.js"
      },
      "module": "./dist/xstate-rivet.esm.js",
      "import": "./dist/xstate-rivet.cjs.mjs",
      "default": "./dist/xstate-rivet.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statelyai/xstate.git"
  },
  "scripts": {},
  "peerDependencies": {
    "rivetkit": "^2.3.10",
    "xstate": "workspace:^"
  },
  "devDependencies": {
    "rivetkit": "^2.3.10",
    "xstate": "workspace:^"
  },
  "preconstruct": {
    "entrypoints": [
      "./index.ts"
    ]
  }
}
