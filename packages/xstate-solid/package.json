    "solid-js": "^2.0.3",
    "xstate": "workspace:^"
  },
  "devDependencies": {
    "@solidjs/compiler": "^2.0.2",
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/web": "^2.0.3",
    "jsdom": "^26.0.0",
    "solid-js": "^2.0.3",
    "xstate": "workspace:^",
    "zod": "^3.25.51"
  }
