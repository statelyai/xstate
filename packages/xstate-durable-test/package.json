{
  "name": "@xstate/durable-test",
  "version": "0.1.0-alpha.0",
  "description": "Conformance tests for XState durable execution adapters",
  "keywords": [
    "xstate",
    "durable execution",
    "adapter",
    "testing"
  ],
  "license": "MIT",
  "main": "dist/xstate-durable-test.cjs.js",
  "module": "dist/xstate-durable-test.esm.js",
