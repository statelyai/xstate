{
  "name": "@xstate/fast-check",
  "version": "0.1.0-alpha.0",
  "description": "FastCheck property testing adapter for XState",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/xstate-fast-check.js",
    "./effect-schema": "./dist/xstate-fast-check-effect-schema.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statelyai/xstate.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "effect": ">=4.0.0-beta.100 <5",
    "fast-check": "^4.9.0",
    "xstate": "workspace:^",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.106",
    "fast-check": "^4.9.0",
    "xstate": "workspace:^",
    "zod": "^4.4.3"
  },
  "preconstruct": {
    "umdName": "XStateFastCheck",
    "entrypoints": [
      "./index.ts",
      "./effect-schema.ts"
    ]
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
